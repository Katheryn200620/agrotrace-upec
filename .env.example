# Copie este archivo como .env y ajuste los valores. No suba el archivo .env a GitHub.
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-secreta
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Al publicar en PythonAnywhere: https://SU_USUARIO.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de datos: sqlite (por defecto), postgres o mysql
DB_ENGINE=sqlite
DB_NAME=agrotrace
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=

# Dirección con la que se generan los QR (use la IP de su computador para probar con el celular)
SITE_URL=http://127.0.0.1:8000
GS1_PREFIJO_EMPRESA=7861234

# Integraciones (fase F5)
N8N_WEBHOOK_COSECHA=
ODOO_URL=http://localhost:8069
ODOO_DB=upec
ODOO_USER=admin
ODOO_PASSWORD=admin

# Asistente virtual con IA (opcional). Sin esto el asistente responde con reglas y datos de la base.
#   IA_PROVEEDOR=ninguno | anthropic | openai
#   - anthropic: API de Claude (necesita IA_API_KEY de console.anthropic.com)
#   - openai: cualquier servicio compatible con OpenAI, por ejemplo Ollama gratuito en su computador:
#       IA_PROVEEDOR=openai  IA_URL=http://localhost:11434/v1  IA_MODELO=qwen2.5:3b  (IA_API_KEY vacío)
IA_PROVEEDOR=ninguno
IA_URL=
IA_MODELO=
IA_API_KEY=
IA_TIEMPO=20
